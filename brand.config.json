{
    "brand_name": "KevDollarAI",
    "brand_domain": "yourbrand.com",
    "brand_hostname": {
        "staging": "staging.yourbrand.com/dashboard",
        "production": "yourbrand.com/dashboard"
    },
    "domain_name": "YourBrand.com",
    "colors": {
        "primary": "#d92d2d",
        "secondary": "#6b7078",
        "tertiary": "#2f7dff",
        "success": "#0a9e6f",
        "danger": "#d92d2d",
        "warning": "#f59a23",
        "info": "#2f7dff",
        "neutral": "#6b7078",
        "black": "#16181c",
        "white": "#ffffff",
        "grey": {
            "50": "#f3f4f6",
            "100": "#eceef1",
            "200": "#dfe2e7",
            "300": "#c9cdd4",
            "400": "#aeb3bc",
            "500": "#6b7078",
            "600": "#595e66",
            "700": "#444951",
            "800": "#2d3138",
            "900": "#16181c"
        }
    },
    "typography": {
        "font_family": {
            "primary": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
            "secondary": "Georgia, 'Times New Roman', Times, serif",
            "monospace": "'SFMono-Regular', Consolas, 'Liberation Mono', monospace"
        },
        "font_sizes": {
            "xs": "0.75rem",
            "sm": "0.875rem",
            "base": "1rem",
            "lg": "1.125rem",
            "xl": "1.25rem",
            "2xl": "1.5rem",
            "3xl": "1.875rem",
            "4xl": "2.25rem"
        }
    },
    "color_variants": {
        "light_variants": [100, 200, 300, 400, 500],
        "dark_variants": [600, 700, 800, 900],
        "opacity_variants": [10, 20, 30, 40, 50, 60, 70, 80, 90]
    },
    "theme_config": {
        "enable_dynamic_themes": true,
        "auto_generate_variants": true,
        "css_variable_prefix": "--brand"
    },
    "platform": {
        "name": "KevDollarAI",
        "logo": {
            "type": "component",
            "component_name": "BrandLogo",
            "alt_text": "KevDollarAI",
            "link_url": "/",
            "show_text": false,
            "text": "KevDollarAI"
        },
        "footer": {
            "enable_language_settings": false,
            "enable_theme_toggle": false
        },
        "hostname": {
            "production": {
                "com": "kevdollaraitrades.netlify.app"
            },
            "staging": {
                "com": "staging-bot.yourbrand.com"
            }
        },
        "auth2_url": {
            "production": "https://auth.deriv.com/oauth2/",
            "staging": "https://staging-auth.deriv.com/oauth2/"
        },
        "derivws": {
            "url": {
                "staging": "https://staging-api.derivws.com/trading/v1/",
                "production": "https://api.derivws.com/trading/v1/"
            },
            "directories": {
                "options": "options/",
                "derivatives": "derivatives/"
            }
        }
    }
}
